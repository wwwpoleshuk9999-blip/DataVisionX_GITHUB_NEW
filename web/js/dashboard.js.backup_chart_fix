
let cpuChart = null;
let memoryChart = null;
let metricsHistory = {
    labels: [],
    cpu: [],
    memory: []
};
async function loadDashboard() {
    const r = await fetch(API + "/dashboard/status", { headers: headers() });
    const d = await r.json();
        console.log("HEALTH DATA", d);

    document.getElementById("system").innerHTML = `
<div class="card">
<h3>🚀 ${d.platform}</h3>
Version: ${d.version}<br>
Status: <b>${d.status}</b><br>
Health: <b>${d.health}</b><br>
Python: ${d.python}<br>
OS: ${d.os}<br>
Uptime: ${d.uptime_seconds}s<br>
Plugins: ${d.plugins_running}/${d.plugins_total}
</div>`;
}

async function loadRuntime() {
    console.log("LOAD RUNTIME START");
    console.log('LOAD RUNTIME START');
        console.log("RUNTIME FETCH START");
    try {
        const r = await fetch(API + "/health", {
            headers: headers()
        });

        const d = await r.json();

        console.log("HEALTH DATA", d);

        document.getElementById("runtime").innerHTML = `
        <div class="card">
        <b>Status:</b> ${d.status}<br>
        <b>Process:</b> ${d.process}<br>
        <b>Plugins:</b> ${d.plugins}<br>
        <b>Running:</b> ${d.plugins_running}<br>
        <b>Stopped:</b> ${d.plugins_stopped}<br>
        <b>Last Action:</b> ${d.last_action}<br>
        <b>Uptime:</b> ${d.uptime}s
        </div>`;

    } catch (e) {
        console.log("RUNTIME ERROR", e);
        document.getElementById("runtime").innerHTML =
        '<div class="card">Runtime unavailable</div>';
    }
}

async function loadRegistry() {

    try {
        const r = await fetch("/registry", {
            headers: headers()
        });

        if (!r.ok) {
            document.getElementById("registry").innerHTML =
                '<div class="card">Registry API unavailable</div>';
            return;
        }

        const d = await r.json();

        let html = "";

        (d.registry || []).forEach(item => {
            html += `
<div class="card">
<b>${item.id}</b><br>
Version: ${item.version}
</div>`;
        });

        document.getElementById("registry").innerHTML = html;

    } catch {
        document.getElementById("registry").innerHTML =
            '<div class="card">Registry unavailable</div>';
    }
}


async function loadPluginHealth() {
    const r = await fetch("/health/plugins", {headers: headers()});
    const d = await r.json();

    let html = "";
    for (const [id, p] of Object.entries(d.plugins || {})) {
        html += `
        <div class="card">
        <b>${id}</b><br>
        Status: ${p.status}<br>
        Health: ${p.health}<br>
        Restarts: ${p.restart_count}
        </div>`;
    }

    document.getElementById("health").innerHTML = html;
}



