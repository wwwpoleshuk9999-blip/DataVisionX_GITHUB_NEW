async function loadMetrics() {
    console.log("LOAD METRICS START");
    const r = await fetch("/metrics/system", {headers: headers()});
    const x = await r.json();

    document.getElementById("metrics").innerHTML = `
    <div class="card">
        <b>CPU:</b> ${x.cpu_percent}%<br>
        <b>Memory:</b> ${x.memory_percent}%<br>
        <b>Disk:</b> ${x.disk_percent}%<br>
    </div>`;

    const now = new Date().toLocaleTimeString();

    metricsHistory.labels.push(now);
    metricsHistory.cpu.push(x.cpu_percent);
    console.log("METRICS DATA", x.cpu_percent, x.memory_percent, metricsHistory.labels.length);
    metricsHistory.memory.push(x.memory_percent);

    if (metricsHistory.labels.length > 20) {
        metricsHistory.labels.shift();
        metricsHistory.cpu.shift();
        metricsHistory.memory.shift();
    }

    console.log("CHART CHECK", typeof Chart);
    console.log("CPU CANVAS", document.getElementById("cpuChart"));
    console.log("MEM CANVAS", document.getElementById("memoryChart"));

    document.getElementById("metrics").innerHTML +=
        "<br><b>Chart:</b> " + typeof Chart +
        "<br><b>CPU canvas:</b> " + !!document.getElementById("cpuChart") +
        "<br><b>Memory canvas:</b> " + !!document.getElementById("memoryChart");

    if (typeof Chart !== "undefined") {

        if (!cpuChart) {
            document.getElementById("metrics").innerHTML +=
                "<br><b>CREATE CPU CHART</b>";

            cpuChart = new Chart(
                document.getElementById("cpuChart"),
                {
                    type: "line",
                    options: { responsive: true, maintainAspectRatio: false }
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    },
                    data: {
                        labels: metricsHistory.labels,
                        datasets: [{
                            label: "CPU %",
                            data: metricsHistory.cpu
                        }]
                    }
                }
            );
        } else {
            cpuChart.update();
        }

        if (!memoryChart) {
            memoryChart = new Chart(
                document.getElementById("memoryChart"),
                {
                    type: "line",
                    options: { responsive: true, maintainAspectRatio: false }
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    },
                    data: {
                        labels: metricsHistory.labels,
                        datasets: [{
                            label: "Memory %",
                            data: metricsHistory.memory
                        }]
                    }
                }
            );
        } else {
            memoryChart.update();
        }
    }
}

